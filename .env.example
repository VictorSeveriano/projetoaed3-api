PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Chave de servidor da Google Maps Routes API v2
# Tipo: chave de servidor (restrita por IP no Google Cloud Console)
# APIs necessárias: Routes API (v2) — não usar Directions API (v1 legado)
# NUNCA commitar o valor real desta chave
GOOGLE_MAPS_API_KEY=sua_chave_servidor_aqui

# Define se certificados TLS são validados ao chamar APIs externas (ViaCEP, Nominatim)
# Use '0' apenas em ambientes de desenvolvimento com problemas de certificado corporativo
# Em produção: manter sem definir (padrão = '1' = validação ativa)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# PostgreSQL / Neon — connection string
# NUNCA commitar o valor real desta variável
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
